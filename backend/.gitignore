# ==============================================================================
# 2. ENTORNOS VIRTUALES (Evita subir librerías pesadas)
# ==============================================================================
.venv/
venv/
ENV/
env/
ENV/
.env/
miniconda/
Anaconda/

# ==============================================================================
# 3. CONFIGURACIÓN Y VARIABLES DE ENTORNO (¡Seguridad Crítica!)
# ==============================================================================
# Ignora las credenciales reales de tu base de datos y llaves secretas
.env
.env.*
!.env.example
.flaskenv
secrets.json

# ==============================================================================
# 4. BASES DE DATOS LOCALES Y MIGRACIONES
# ==============================================================================
# Archivos de bases de datos locales (SQLite)
*.db
*.sqlite
*.sqlite3

# Logs de bases de datos o volcados de datos locales
*.sql
*.dump

# Migraciones (Opcional: Si usas Alembic, NO ignores la carpeta de versiones)
# Descomenta la siguiente línea solo si quieres ignorar logs específicos de Alembic
# alembic.log

# ==============================================================================
# 5. HERRAMIENTAS DE PRUEBA Y COBERTURA
# ==============================================================================
.htmlcov/
.tox/
.nosetests/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
htmlcov/
.pytest_cache/
.pytest/

